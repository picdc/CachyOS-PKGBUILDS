 {
 }
 
-NV_STATUS NV_API_CALL nv_i2c_bus_status(
+static NV_STATUS NV_API_CALL nv_i2c_bus_status(
     nv_state_t *nv,
     NvU32 linuxI2CSwPort,
     NvS32 *scl,
