+++ b/kernel-open/nvidia/nv-clk.c
@@ -833,7 +833,7 @@ NV_STATUS NV_API_CALL nv_dp_uphy_pll_deinit(nv_state_t *nv)
 #endif
 }
 #else
-NV_STATUS NV_API_CALL nv_set_parent
+static NV_STATUS NV_API_CALL nv_set_parent
 (
     nv_state_t *nv,
     TEGRASOC_WHICH_CLK whichClkOSsource,
@@ -844,13 +844,13 @@ NV_STATUS NV_API_CALL nv_set_parent
 }
 
 
-NvBool NV_API_CALL nv_is_clk_enabled(
+static NvBool NV_API_CALL nv_is_clk_enabled(
     nv_state_t *nv, TEGRASOC_WHICH_CLK whichClkOS)
 {
     return NV_FALSE;
 }
 
-NV_STATUS NV_API_CALL nv_dp_uphy_pll_deinit(nv_state_t *nv)
+static NV_STATUS NV_API_CALL nv_dp_uphy_pll_deinit(nv_state_t *nv)
 {
     return NV_ERR_NOT_SUPPORTED;
 }
